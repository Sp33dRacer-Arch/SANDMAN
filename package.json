{
  "name": "sandman-engine-parts-backend",
  "version": "2.3.0",
  "private": true,
  "description": "SANDMAN V2.3 vehicle-first automotive commerce platform with clean SEO URLs, VIN-assisted vehicle resolution, ranked search, shipping/tracking, seller reputation, verified photo reviews and returns.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "verify": "npm run verify:ui && npm run prisma:generate && prisma validate && npm run typecheck && npm test && npm run build",
    "vehicle:check": "node scripts/vehicle-catalog-check.mjs",
    "vehicle:sync:bmw": "node scripts/sync-vehicle-catalog.mjs --source=curated --only-make=BMW --from=1996 --to=2027",
    "verify:ui": "node --check public/store/app.js && node --check public/admin/app.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nanoid": "^5.1.5",
    "stripe": "^18.5.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.0",
    "prisma": "6.19.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
