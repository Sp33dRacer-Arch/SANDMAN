NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sandman?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CURRENCY=USD

# Stripe (optional until checkout is enabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supplier integrations
DEFAULT_SUPPLIER=mock
CJ_API_KEY=
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1

# Shipping / tax placeholders
FREE_SHIPPING_THRESHOLD=250
FLAT_SHIPPING_RATE=18
DEFAULT_TAX_RATE=0
