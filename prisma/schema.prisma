generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SUBMITTED_TO_SUPPLIER
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum SupplierType {
  MOCK
  CJ
  SYNCEE
  CUSTOM
}

enum PayoutStatus {
  PENDING
  READY
  PAID
  FAILED
  BLOCKED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductSource {
  DROPSHIP
  MARKETPLACE
}

enum PartCondition {
  NEW
  USED
  REMANUFACTURED
  OPEN_BOX
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  garage       GarageVehicle[]
  cart         Cart?
  orders       Order[]
  marketplaceProducts Product[] @relation("MarketplaceSeller")
  sessions            AuthSession[]
  sellerPayouts       SellerPayout[]
  stripeConnectAccountId String?  @unique
  stripeConnectChargesEnabled Boolean @default(false)
  stripeConnectPayoutsEnabled Boolean @default(false)
  sellerCommissionAcceptedAt DateTime?
  sellerCountry       String?
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Address {
  id         String      @id @default(cuid())
  userId     String?
  type       AddressType
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VehicleMake {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model VehicleModel {
  id        String          @id @default(cuid())
  makeId    String
  name      String
  slug      String
  make      VehicleMake     @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants  VehicleVariant[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([makeId, slug])
}

model VehicleVariant {
  id               String          @id @default(cuid())
  modelId          String
  yearStart        Int
  yearEnd          Int
  trim             String?
  chassisCode      String?
  engineCode       String
  engineName       String
  displacementCc   Int?
  aspiration       String?
  fuelType         String?
  transmission     String?
  drivetrain       String?
  model            VehicleModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  productFitments  ProductFitment[]
  garageVehicles   GarageVehicle[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([engineCode])
  @@index([yearStart, yearEnd])
}

model GarageVehicle {
  id               String         @id @default(cuid())
  userId           String
  vehicleVariantId String
  nickname         String?
  year             Int
  vin              String?
  isPrimary        Boolean        @default(false)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleVariant   VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  slug           String          @unique
  name           String
  brand          String?
  manufacturerPn String?
  description    String
  shortDesc      String?
  status         ProductStatus   @default(DRAFT)
  categoryId     String
  priceCents     Int
  compareAtCents Int?
  currency       String          @default("USD")
  weightGrams    Int?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  requiresFitment Boolean        @default(true)
  isUniversal    Boolean         @default(false)
  taxable        Boolean         @default(true)
  sourceType     ProductSource   @default(DROPSHIP)
  condition      PartCondition   @default(NEW)
  sellerId       String?
  stockQuantity  Int?
  sellerShippingCents Int        @default(0)
  sellerLocation String?
  sellerNotes    String?
  category       Category        @relation(fields: [categoryId], references: [id])
  seller         User?           @relation("MarketplaceSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  fitments       ProductFitment[]
  supplierLinks  SupplierProduct[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, categoryId])
  @@index([brand])
  @@index([manufacturerPn])
  @@index([sourceType, status, createdAt])
  @@index([sellerId, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductFitment {
  id               String         @id @default(cuid())
  productId        String
  vehicleVariantId String
  notes            String?
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleVariant   VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleVariantId])
  @@index([vehicleVariantId])
}

model Supplier {
  id             String            @id @default(cuid())
  name           String
  code           String            @unique
  type           SupplierType      @default(CUSTOM)
  active         Boolean           @default(true)
  priority       Int               @default(100)
  baseUrl        String?
  apiKeyEnvName  String?
  products       SupplierProduct[]
  fulfillments   Fulfillment[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model SupplierProduct {
  id                String   @id @default(cuid())
  supplierId        String
  productId         String
  supplierProductId String
  supplierSku       String?
  costCents         Int
  shippingCents     Int      @default(0)
  currency          String   @default("USD")
  stock             Int?
  active            Boolean  @default(true)
  lastSyncedAt      DateTime?
  rawData           Json?
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([supplierId, supplierProductId])
  @@index([productId, active, costCents])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  fitmentVehicleVariantId String?
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  userId                String?
  email                 String
  status                 OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus          PaymentStatus     @default(PENDING)
  currency               String            @default("USD")
  subtotalCents          Int
  shippingCents          Int
  taxCents               Int
  discountCents          Int               @default(0)
  totalCents             Int
  shippingAddress        Json
  billingAddress         Json?
  stripePaymentIntentId  String?           @unique
  paypalOrderId          String?           @unique
  paymentProvider        String?
  customerNote           String?
  internalNote           String?
  marketplaceStockReleasedAt DateTime?
  user                   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  fulfillments           Fulfillment[]
  events                 OrderEvent[]
  sellerPayouts          SellerPayout[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String?
  sku                 String
  name                String
  quantity            Int
  unitPriceCents      Int
  totalPriceCents     Int
  supplierId          String?
  supplierProductId   String?
  supplierCostCents   Int?
  fitmentSnapshot     Json?
  sourceType          ProductSource @default(DROPSHIP)
  sellerId            String?
  sellerTrackingNumber String?
  sellerCarrier       String?
  sellerShippedAt     DateTime?
  sellerShippingCents Int @default(0)
  platformFeeCents    Int @default(0)
  sellerPayoutCents   Int?
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model SellerPayout {
  id                String       @id @default(cuid())
  orderId           String
  sellerId          String
  amountCents       Int
  platformFeeCents  Int
  currency          String       @default("USD")
  status            PayoutStatus @default(PENDING)
  stripeTransferId  String?      @unique
  errorMessage      String?
  paidAt            DateTime?
  readyAt           DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller            User         @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([orderId, sellerId])
  @@index([sellerId, status])
}

model Fulfillment {
  id                    String            @id @default(cuid())
  orderId               String
  supplierId            String
  status                 FulfillmentStatus @default(PENDING)
  supplierOrderId       String?
  trackingNumber        String?
  trackingUrl           String?
  carrier               String?
  errorMessage          String?
  rawResponse           Json?
  submittedAt           DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier              Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([orderId, supplierId])
  @@index([orderId])
  @@index([supplierId, status])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  metadata  Json?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model WebhookEvent {
  id           String   @id @default(cuid())
  provider     String
  externalId   String
  eventType    String
  processed    Boolean  @default(false)
  payload      Json
  errorMessage String?
  createdAt    DateTime @default(now())
  processedAt  DateTime?

  @@unique([provider, externalId])
}
