generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SUBMITTED_TO_SUPPLIER
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
  REFUNDED
  FAILED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
}

enum SupplierType {
  MOCK
  CJ
  SYNCEE
  CUSTOM
}

enum PayoutStatus {
  PENDING
  READY
  PROCESSING
  PAID
  FAILED
  BLOCKED
}

enum AddressType {
  SHIPPING
  BILLING
}

enum ProductSource {
  DROPSHIP
  MARKETPLACE
}

enum PartCondition {
  NEW
  USED
  REMANUFACTURED
  OPEN_BOX
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum OfferStatus {
  OPEN
  COUNTERED
  ACCEPTED
  RESERVED
  PURCHASED
  DECLINED
  EXPIRED
  CANCELLED
}

enum SupportCaseType {
  RETURN
  NOT_RECEIVED
  WRONG_ITEM
  DAMAGED
  NOT_AS_DESCRIBED
  COUNTERFEIT
  OTHER
}

enum SupportCaseStatus {
  OPEN
  UNDER_REVIEW
  AWAITING_SELLER
  APPROVED
  REJECTED
  RESOLVED
  CLOSED
}

enum AlertType {
  PRICE_DROP
  RESTOCK
}

enum RequestStatus {
  OPEN
  REVIEWING
  SOURCED
  CLOSED
}

enum FitmentSource {
  MANUAL
  SUPPLIER
  OEM
  COMMUNITY
  IMPORTED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  phone        String?
  role         UserRole  @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  garage       GarageVehicle[]
  cart         Cart?
  orders       Order[]
  marketplaceProducts Product[] @relation("MarketplaceSeller")
  sessions            AuthSession[]
  sellerPayouts       SellerPayout[]
  stripeConnectAccountId String?  @unique
  stripeConnectChargesEnabled Boolean @default(false)
  stripeConnectPayoutsEnabled Boolean @default(false)
  sellerCommissionAcceptedAt DateTime?
  sellerCountry       String?
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean   @default(false)
  twoFactorSecretEnc  String?
  sellerProfile       SellerProfile?
  productReviews      ProductReview[]
  sellerReviewsWritten SellerReview[] @relation("SellerReviewWriter")
  sellerReviewsReceived SellerReview[] @relation("SellerReviewSeller")
  wishlistItems       WishlistItem[]
  productAlerts       ProductAlert[]
  builds              Build[]
  offersAsBuyer       Offer[] @relation("OfferBuyer")
  offersAsSeller      Offer[] @relation("OfferSeller")
  conversationsAsBuyer Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messages            Message[]
  supportCases        SupportCase[]
  notifications       Notification[]
  searchEvents        SearchEvent[]
  recentlyViewed     RecentlyViewed[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  vehicleRequests VehicleRequest[]
  partRequests    PartRequest[]
}

model AuthSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime @default(now())
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Address {
  id         String      @id @default(cuid())
  userId     String?
  type       AddressType
  firstName  String
  lastName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VehicleMake {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  models    VehicleModel[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model VehicleModel {
  id        String          @id @default(cuid())
  makeId    String
  name      String
  slug      String
  make      VehicleMake     @relation(fields: [makeId], references: [id], onDelete: Cascade)
  variants  VehicleVariant[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([makeId, slug])
}

model VehicleVariant {
  id               String          @id @default(cuid())
  modelId          String
  yearStart        Int
  yearEnd          Int
  trim             String?
  chassisCode      String?
  engineCode       String
  engineName       String
  displacementCc   Int?
  aspiration       String?
  fuelType         String?
  transmission     String?
  drivetrain       String?
  model            VehicleModel    @relation(fields: [modelId], references: [id], onDelete: Cascade)
  productFitments  ProductFitment[]
  garageVehicles   GarageVehicle[]
  builds            Build[]
  partRequests      PartRequest[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([engineCode])
  @@index([yearStart, yearEnd])
}

model GarageVehicle {
  id               String         @id @default(cuid())
  userId           String
  vehicleVariantId String
  nickname         String?
  year             Int
  vin              String?
  isPrimary        Boolean        @default(false)
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleVariant   VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  builds           Build[]

  @@index([userId])
}


model VehicleRequest {
  id         String        @id @default(cuid())
  userId     String?
  email      String?
  make       String
  model      String
  year       Int?
  trim       String?
  engineCode String?
  notes      String?
  status     RequestStatus @default(OPEN)
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model PartRequest {
  id               String          @id @default(cuid())
  userId           String?
  email            String?
  vehicleVariantId String?
  partName         String
  oemNumber        String?
  notes            String?
  budgetCents      Int?
  status           RequestStatus   @default(OPEN)
  user             User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleVariant   VehicleVariant? @relation(fields: [vehicleVariantId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([vehicleVariantId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryTree")
  products    Product[]
  pricingRules PricingRule[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  slug           String          @unique
  name           String
  brand          String?
  manufacturerPn String?
  description    String
  shortDesc      String?
  status         ProductStatus   @default(DRAFT)
  categoryId     String
  priceCents     Int
  compareAtCents Int?
  currency       String          @default("USD")
  weightGrams    Int?
  lengthMm       Int?
  widthMm        Int?
  heightMm       Int?
  requiresFitment Boolean        @default(true)
  isUniversal    Boolean         @default(false)
  taxable        Boolean         @default(true)
  sourceType     ProductSource   @default(DROPSHIP)
  condition      PartCondition   @default(NEW)
  sellerId       String?
  stockQuantity  Int?
  sellerShippingCents Int        @default(0)
  sellerLocation String?
  sellerNotes    String?
  warrantyText   String?
  returnDays     Int?
  installDifficulty String?
  specs          Json?
  videoUrl       String?
  shippingMinDays Int?
  shippingMaxDays Int?
  seoTitle       String?
  seoDescription String?
  viewCount      Int             @default(0)
  purchaseCount  Int             @default(0)
  wishlistCount  Int             @default(0)
  category       Category        @relation(fields: [categoryId], references: [id])
  seller         User?           @relation("MarketplaceSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  images         ProductImage[]
  fitments       ProductFitment[]
  supplierLinks  SupplierProduct[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  reviews        ProductReview[]
  wishlists      WishlistItem[]
  alerts         ProductAlert[]
  buildItems     BuildItem[]
  offers         Offer[]
  conversations  Conversation[]
  recentlyViewed RecentlyViewed[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, categoryId])
  @@index([brand])
  @@index([manufacturerPn])
  @@index([sourceType, status, createdAt])
  @@index([sellerId, status])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId, position])
}

model ProductFitment {
  id               String         @id @default(cuid())
  productId        String
  vehicleVariantId String
  notes            String?
  verified         Boolean        @default(false)
  source           FitmentSource  @default(MANUAL)
  verifiedAt       DateTime?
  product          Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  vehicleVariant   VehicleVariant @relation(fields: [vehicleVariantId], references: [id], onDelete: Cascade)

  @@unique([productId, vehicleVariantId])
  @@index([vehicleVariantId])
  @@index([verified, source])
}

model Supplier {
  id             String            @id @default(cuid())
  name           String
  code           String            @unique
  type           SupplierType      @default(CUSTOM)
  active         Boolean           @default(true)
  priority       Int               @default(100)
  baseUrl        String?
  apiKeyEnvName  String?
  products       SupplierProduct[]
  fulfillments   Fulfillment[]
  pricingRules   PricingRule[]
  syncRuns       SupplierSyncRun[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

model SupplierProduct {
  id                String   @id @default(cuid())
  supplierId        String
  productId         String
  supplierProductId String
  supplierSku       String?
  costCents         Int
  shippingCents     Int      @default(0)
  currency          String   @default("USD")
  stock             Int?
  reservedStock     Int      @default(0)
  availableStock    Int?
  active            Boolean  @default(true)
  leadTimeDays      Int?
  warehouseCountry String?
  reliabilityScore Float?
  lastSyncedAt      DateTime?
  rawData           Json?
  supplier          Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([supplierId, supplierProductId])
  @@index([productId, active, costCents])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  fitmentVehicleVariantId String?
  offerId   String?  @unique
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  offer     Offer?   @relation(fields: [offerId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model Order {
  id                    String            @id @default(cuid())
  orderNumber           String            @unique
  userId                String?
  email                 String
  status                 OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus          PaymentStatus     @default(PENDING)
  currency               String            @default("USD")
  subtotalCents          Int
  shippingCents          Int
  taxCents               Int
  discountCents          Int               @default(0)
  promoCode              String?
  promoCountedAt         DateTime?
  totalCents             Int
  shippingAddress        Json
  billingAddress         Json?
  stripePaymentIntentId  String?           @unique
  paypalOrderId          String?           @unique
  paymentProvider        String?
  customerNote           String?
  internalNote           String?
  marketplaceStockReleasedAt DateTime?
  refundInProgressAt     DateTime?
  refundInProgressCaseId String?
  user                   User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  items                  OrderItem[]
  fulfillments           Fulfillment[]
  events                 OrderEvent[]
  sellerPayouts          SellerPayout[]
  supportCases           SupportCase[]
  refunds                RefundRecord[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  productId           String?
  sku                 String
  name                String
  quantity            Int
  unitPriceCents      Int
  totalPriceCents     Int
  discountCents       Int      @default(0)
  offerId             String?  @unique
  supplierId          String?
  supplierProductId   String?
  supplierLinkId      String?
  supplierStockReservedAt DateTime?
  supplierStockReleasedAt DateTime?
  supplierStockCommittedAt DateTime?
  supplierCostCents   Int?
  fitmentSnapshot     Json?
  sourceType          ProductSource @default(DROPSHIP)
  sellerId            String?
  sellerTrackingNumber String?
  sellerCarrier       String?
  sellerShippedAt     DateTime?
  sellerShippingCents Int @default(0)
  platformFeeCents    Int @default(0)
  sellerPayoutCents   Int?
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productReview       ProductReview?
  sellerReview        SellerReview?
  offer               Offer?   @relation("OrderItemOffer", fields: [offerId], references: [id], onDelete: SetNull)
  supportCases        SupportCase[]

  @@index([orderId])
  @@index([supplierLinkId])
}

model SellerPayout {
  id                String       @id @default(cuid())
  orderId           String
  sellerId          String
  amountCents       Int
  platformFeeCents  Int
  currency          String       @default("USD")
  status            PayoutStatus @default(PENDING)
  stripeTransferId  String?      @unique
  errorMessage      String?
  paidAt            DateTime?
  readyAt           DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  order             Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller            User         @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([orderId, sellerId])
  @@index([sellerId, status])
}

model Fulfillment {
  id                    String            @id @default(cuid())
  orderId               String
  supplierId            String
  status                 FulfillmentStatus @default(PENDING)
  supplierOrderId       String?
  trackingNumber        String?
  trackingUrl           String?
  carrier               String?
  errorMessage          String?
  rawResponse           Json?
  submittedAt           DateTime?
  shippedAt             DateTime?
  deliveredAt           DateTime?
  order                 Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supplier              Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@unique([orderId, supplierId])
  @@index([orderId])
  @@index([supplierId, status])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  message   String
  metadata  Json?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model WebhookEvent {
  id           String   @id @default(cuid())
  provider     String
  externalId   String
  eventType    String
  processed    Boolean  @default(false)
  payload      Json
  errorMessage String?
  createdAt    DateTime @default(now())
  processedAt  DateTime?

  @@unique([provider, externalId])
}

model SellerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  storeName          String?
  bio                String?
  location           String?
  verified           Boolean  @default(false)
  responseTimeHours  Int?
  totalSales          Int      @default(0)
  ratingAverage      Float    @default(0)
  ratingCount        Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductReview {
  id               String       @id @default(cuid())
  userId           String
  productId        String
  orderItemId      String?      @unique
  rating           Int
  title            String?
  body             String?
  mediaUrls        Json?
  verifiedPurchase Boolean      @default(false)
  status           ReviewStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  product          Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem        OrderItem?   @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, orderItemId])
  @@index([productId, status, createdAt])
}

model SellerReview {
  id               String       @id @default(cuid())
  reviewerId       String
  sellerId         String
  orderItemId      String       @unique
  rating           Int
  body             String?
  verifiedPurchase Boolean      @default(true)
  status           ReviewStatus @default(PUBLISHED)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  reviewer         User         @relation("SellerReviewWriter", fields: [reviewerId], references: [id], onDelete: Cascade)
  seller           User         @relation("SellerReviewSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  orderItem        OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([sellerId, status, createdAt])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

model ProductAlert {
  id             String    @id @default(cuid())
  userId         String
  productId      String
  type           AlertType
  targetPriceCents Int?
  active         Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, type])
  @@index([productId, type, active])
}

model Build {
  id              String          @id @default(cuid())
  userId          String
  garageVehicleId String?
  vehicleVariantId String?
  name            String
  targetPowerHp   Int?
  targetTorqueNm  Int?
  budgetCents     Int?
  goal            String?
  notes           String?
  isPublic        Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  garageVehicle   GarageVehicle?  @relation(fields: [garageVehicleId], references: [id], onDelete: SetNull)
  vehicleVariant  VehicleVariant? @relation(fields: [vehicleVariantId], references: [id], onDelete: SetNull)
  items           BuildItem[]

  @@index([userId, updatedAt])
}

model BuildItem {
  id        String   @id @default(cuid())
  buildId   String
  productId String
  quantity  Int      @default(1)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  build     Build    @relation(fields: [buildId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buildId, productId])
  @@index([buildId])
}

model Offer {
  id          String      @id @default(cuid())
  productId   String
  buyerId     String
  sellerId    String
  amountCents Int
  status      OfferStatus @default(OPEN)
  parentId    String?
  createdById String
  message     String?
  expiresAt   DateTime?
  acceptedAt  DateTime?
  purchasedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer       User        @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller      User        @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  parent      Offer?      @relation("OfferThread", fields: [parentId], references: [id], onDelete: SetNull)
  counters    Offer[]     @relation("OfferThread")
  cartItem    CartItem?
  orderItem   OrderItem? @relation("OrderItemOffer")

  @@index([productId, status, createdAt])
  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  productId String
  buyerId   String
  sellerId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyer     User     @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller    User     @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@unique([productId, buyerId, sellerId])
  @@index([buyerId, updatedAt])
  @@index([sellerId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model SupportCase {
  id             String            @id @default(cuid())
  userId         String
  orderId        String
  orderItemId    String?
  sellerId       String?
  type           SupportCaseType
  status         SupportCaseStatus @default(OPEN)
  reason         String
  details        String?
  evidenceUrls   Json?
  requestedRefundCents Int?
  approvedRefundCents Int?
  resolution     String?
  sellerResponse String?
  sellerRespondedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem      OrderItem?        @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  refund         RefundRecord?

  @@index([userId, status, createdAt])
  @@index([orderId, status])
  @@index([sellerId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model PromoCode {
  id             String   @id @default(cuid())
  code           String   @unique
  percentOff     Int?
  amountOffCents Int?
  minimumCents   Int      @default(0)
  maxUses        Int?
  uses           Int      @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SearchEvent {
  id           String   @id @default(cuid())
  userId       String?
  query        String
  resultsCount Int
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([query])
}

model PricingRule {
  id            String    @id @default(cuid())
  name          String
  supplierId    String?
  categoryId    String?
  markupPercent Float?
  fixedMarkupCents Int?
  minimumProfitCents Int?
  active        Boolean   @default(true)
  priority      Int       @default(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([active, priority])
}

model SupplierSyncRun {
  id            String   @id @default(cuid())
  supplierId    String
  status        String
  productsSeen  Int      @default(0)
  productsUpdated Int    @default(0)
  stockUpdates  Int      @default(0)
  errorMessage  String?
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  supplier      Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, startedAt])
}


model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model RefundRecord {
  id               String   @id @default(cuid())
  orderId          String
  supportCaseId    String?  @unique
  sellerId         String?
  amountCents      Int
  sellerPayoutAdjustmentCents Int @default(0)
  platformFeeAdjustmentCents Int @default(0)
  payoutAdjustedAt DateTime?
  currency         String
  provider         String
  externalRefundId String?  @unique
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  supportCase      SupportCase? @relation(fields: [supportCaseId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([sellerId, createdAt])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
}
