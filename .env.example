NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
API_URL=http://localhost:4000
DATABASE_URL=postgresql://sandman:sandman@localhost:5432/sandman?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Recommended in production: separate secret used only to encrypt authenticator secrets.
TOTP_ENCRYPTION_KEY=
JWT_EXPIRES_IN=2h
SESSION_DAYS=90
CURRENCY=USD

# Stripe: Payment Element + Connect marketplace payouts
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal checkout (optional)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Optional manual EFT/bank transfer instructions shown at checkout
BANK_TRANSFER_INSTRUCTIONS=

# Product/marketplace image uploads (Cloudinary signed browser uploads)
# Keep CLOUDINARY_API_SECRET only in Railway/server environment.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Verification/security email delivery. Use Resend directly or your existing webhook bridge.
RESEND_API_KEY=
EMAIL_FROM=security@example.com
EMAIL_DELIVERY_WEBHOOK_URL=
EMAIL_DELIVERY_WEBHOOK_SECRET=

# Optional SMS verification. Configure Twilio directly or a signed SMS webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DELIVERY_WEBHOOK_URL=
SMS_DELIVERY_WEBHOOK_SECRET=

# User-generated image safety. Point this at a moderation worker/provider.
# Production always fails closed until a moderation webhook returns an explicit SAFE/ALLOW decision.
# REQUIRE_IMAGE_MODERATION=true applies the same fail-closed rule in development/testing too.
CONTENT_MODERATION_WEBHOOK_URL=
CONTENT_MODERATION_WEBHOOK_SECRET=
REQUIRE_IMAGE_MODERATION=false

# SANDMAN marketplace commission and payout controls
MARKETPLACE_COMMISSION_PERCENT=10
MARKETPLACE_PAYOUT_DELAY_DAYS=7

# Supplier integrations
DEFAULT_SUPPLIER=mock
CJ_API_KEY=
CJ_BASE_URL=https://developers.cjdropshipping.com/api2.0/v1
SYNCEE_ORDERS_URL=https://syncee.com
SYNCEE_MODE=manual
SUPPLIER_FEED_SECRET=
AUTO_PRICE_SUPPLIER_FEEDS=false
CHECKOUT_RESERVATION_MINUTES=30
BANK_TRANSFER_RESERVATION_HOURS=48

FREE_SHIPPING_THRESHOLD=250
FLAT_SHIPPING_RATE=18
DEFAULT_TAX_RATE=0

# Demo seed safety: leave false/empty in production.
# Set true only when you intentionally want demo accounts/data on a non-production database.
ALLOW_DEMO_SEED=false
